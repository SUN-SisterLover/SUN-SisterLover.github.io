# 复制本文件为 .env，并填入你的密钥。密钥只存在服务端，不会打进前端 bundle。

# Steam Web API Key —— 必需，否则 Steam 状态卡自动隐藏
# 申请：https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# 网易云音乐 cookie —— 可选，提升音质（登录网易云网页版后复制完整 cookie）
NETEASE_COOKIE=

# B站 cookie —— 可选，用于数据墙 B站卡的「最近投稿」列表
# 获取：浏览器登录 bilibili.com → 开发者工具 → Application → Cookies → 复制
# 形如：SESSDATA=xxxx; bili_jct=xxxx
BILI_COOKIE=

# ── 数据墙（/about）账号身份 ─────────────────────────────
# B站 UID（空间地址里的数字，如 space.bilibili.com/546195 → 546195）
BILI_UID=
# Bangumi 用户名（bgm.tv/user/你的名字）
BANGUMI_USERNAME=
# AniList 用户名（anilist.co/user/你的名字）
ANILIST_USERNAME=

# ── 访客留言管理 ─────────────────────────────────
# 管理页 /manage 删除留言所需。不配置则删除接口关闭（留言提交不受影响）。
# 建议用长随机串，例如：openssl rand -hex 32
COMMENTS_ADMIN_KEY=
